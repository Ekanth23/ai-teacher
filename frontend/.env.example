# Base URL of the AI Teacher backend API (no trailing slash).
#
# The API client appends paths such as /api/auth/login and /api/student/dashboard
# to this base URL. Use an empty value to hit the same origin (e.g. when the
# frontend is served behind a reverse proxy).
#
# Example (local backend development server):
VITE_API_BASE_URL=http://localhost:3000
