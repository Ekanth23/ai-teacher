# Example environment variables
# Copy this file to .env and update the values.

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_teacher_dev

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

AI_PROVIDER=mock
# Available values:
#   AI_PROVIDER=ollama   (local Ollama server)
#   AI_PROVIDER=deepseek (DeepSeek API)
#   AI_PROVIDER=mock     (deterministic test response, no external service)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# DeepSeek provider (optional — used when provider selection is enabled)
# DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Development-only student seed (used by `npm run db:seed:dev`) ---
# The seed refuses to run unless NODE_ENV is exactly "development".
NODE_ENV=development
# Login credentials for the seeded student account (never commit real secrets;
# copy this file to .env and replace the password).
DEV_STUDENT_EMAIL=dev.student@example.com
DEV_STUDENT_PASSWORD=change-me-dev-only
