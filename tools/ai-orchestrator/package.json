{
  "name": "ai-teacher-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "AI Teacher Development Orchestrator - Stage 2A skeleton. Control layer between the human/ChatGPT PO and OpenCode. Contains no AI Teacher product logic.",
  "type": "module",
  "main": "./dist/orchestrator.js",
  "types": "./dist/orchestrator.d.ts",
  "bin": {
    "ai-orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "status": "node dist/cli.js status",
    "help": "node dist/cli.js help",
    "orchestrator": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "ai-teacher",
    "orchestrator",
    "workflow",
    "opencode"
  ],
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
